{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Earth Simulator documentation catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "title", "language", "updated_at", "game_version", "path_base", "source_registry_path", "limitations", "status_definitions", "migration", "categories", "documents", "features"],
  "properties": {
    "$schema": {"const": "./catalog.schema.json"},
    "schema_version": {"const": "1.0.0"},
    "title": {"type": "string", "minLength": 1},
    "language": {"const": "ru"},
    "updated_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "game_version": {"type": "string", "minLength": 1},
    "path_base": {"const": "repository_root"},
    "source_registry_path": {"$ref": "#/$defs/path"},
    "limitations": {"$ref": "#/$defs/strings"},
    "status_definitions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentation_status", "research_status", "evidence_levels"],
      "properties": {
        "documentation_status": {"$ref": "#/$defs/stringMap"},
        "research_status": {"$ref": "#/$defs/stringMap"},
        "evidence_levels": {"$ref": "#/$defs/stringMap"}
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "former_game_design_sha256", "original_archive_sha256", "note"],
      "properties": {
        "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "former_game_design_sha256": {"$ref": "#/$defs/sha256"},
        "original_archive_sha256": {"$ref": "#/$defs/sha256"},
        "note": {"type": "string", "minLength": 1}
      }
    },
    "categories": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "title"],
        "properties": {"id": {"$ref": "#/$defs/category"}, "title": {"type": "string", "minLength": 1}}
      }
    },
    "documents": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/document"}},
    "features": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/feature"}}
  },
  "$defs": {
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/|[A-Za-z]:|.*\\\\|(?:.*[\\/])?\\.\\.(?:/|$)).+$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "category": {"type": "string", "enum": ["foundation", "menu", "interface", "simulation", "states", "society", "walk", "network", "research"]},
    "documentId": {"type": "string", "pattern": "^DOC-[A-Z0-9]+(?:-[A-Z0-9]+)*$"},
    "featureId": {"type": "string", "pattern": "^FEAT-[A-Z0-9]+(?:-[A-Z0-9]+)*$"},
    "strings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "stringMap": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "sourceIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^SRC-[0-9]{3}$"}},
    "documentIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/documentId"}},
    "featureIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/featureId"}},
    "paths": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
    "document": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "path", "kind", "category", "documentation_status", "legacy_sections", "source_ids", "feature_ids", "image_paths"],
      "properties": {
        "id": {"$ref": "#/$defs/documentId"},
        "title": {"type": "string", "minLength": 1},
        "path": {"$ref": "#/$defs/path"},
        "kind": {"type": "string", "enum": ["topic", "historical_questions", "research_stub", "navigation", "analysis", "research_coverage", "sources", "open_questions", "research_state", "changelog", "original_archive", "catalog", "schema"]},
        "category": {"$ref": "#/$defs/category"},
        "documentation_status": {"type": "string", "enum": ["detailed", "stub", "reference", "archived"]},
        "legacy_sections": {"$ref": "#/$defs/strings"},
        "source_ids": {"$ref": "#/$defs/sourceIds"},
        "feature_ids": {"$ref": "#/$defs/featureIds"},
        "image_paths": {"$ref": "#/$defs/paths"}
      }
    },
    "feature": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "category", "summary", "document_ids", "documentation_status", "research_status", "evidence_levels", "source_ids", "runtime_verified", "implementation_entry_points", "open_questions"],
      "properties": {
        "id": {"$ref": "#/$defs/featureId"},
        "title": {"type": "string", "minLength": 1},
        "category": {"$ref": "#/$defs/category"},
        "summary": {"type": "string", "minLength": 1},
        "document_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/documentId"}},
        "documentation_status": {"type": "string", "enum": ["detailed", "mentioned", "stub"]},
        "research_status": {"type": "string", "enum": ["not_researched", "partial"]},
        "evidence_levels": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["original_document", "static_code", "runtime_observation"]}},
        "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^SRC-[0-9]{3}$"}},
        "runtime_verified": {"type": "boolean"},
        "implementation_entry_points": {"$ref": "#/$defs/paths"},
        "open_questions": {"$ref": "#/$defs/strings"}
      }
    }
  }
}
